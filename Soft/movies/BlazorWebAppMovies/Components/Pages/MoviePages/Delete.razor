@page "/movies/delete"
@using Microsoft.EntityFrameworkCore
@using Abc.Data
@inject IDbContextFactory<BlazorWebAppMovies.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Movie</h2>
    <hr />
    @if (movie is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <MyPropertyViewer Label="Title" Value="@movie.Name" />
        <MyPropertyViewer Label="Release Date" Value="@movie.ValidFrom" />
        <MyPropertyViewer Label="Genre" Value="@movie.Genre" />
        <MyPropertyViewer Label="Price" Value="@movie.Price" />
        <MyPropertyViewer Label="Rating" Value="@movie.Rating" />
        <EditForm method="post" Model="movie" OnValidSubmit="DeleteMovie" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(movie is null)">Delete</button> |
            <a href="/movies">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Movie? movie;

    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        movie = await context.Movie.FirstOrDefaultAsync(m => m.Id == Id);

        if (movie is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteMovie()
    {
        using var context = DbFactory.CreateDbContext();
        context.Movie.Remove(movie!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/movies");
    }
}
