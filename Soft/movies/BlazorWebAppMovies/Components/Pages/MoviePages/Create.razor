@page "/movies/create"
@using Abc.Data
@using Microsoft.EntityFrameworkCore
@attribute [ExcludeFromInteractiveRouting]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create Movie</PageTitle>

<h1>Create</h1>

<h2>Movie</h2>

<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="movie" OnValidSubmit="addMovie" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <MyPropertyEditor TValue="string" Id="title" Label="Title:" @bind-Value="movie.Name" />
            <MyPropertyEditor TValue="DateTime?" Id="releasedate" Label="Release Date:" @bind-Value="movie.ValidFrom" />
            <MyPropertyEditor TValue="string" Id="genre" Label="Genre:" @bind-Value="movie.Genre" />
            <MyPropertyEditor TValue="decimal" Id="price" Label="Price:" @bind-Value="movie.Price" />
            <MyPropertyEditor TValue="string" Id="rating" Label="Rating:" @bind-Value="movie.Rating" />
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/movies">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Movie movie { get; set; } = default!;

    protected override void OnInitialized() => movie ??= new();
    private async Task addMovie()
    {
        using var context = DbFactory.CreateDbContext();
        context.Movie.Add(movie);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/movies");
    }
}
