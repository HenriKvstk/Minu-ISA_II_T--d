@page "/countries"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Abc.Data
@using BlazorWebAppMovies.Data
@implements IAsyncDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Countries</PageTitle>

<h1>Countries</h1>
 
<p>
    <a href="countries/create">Create New</a>
</p>
<div>
<QuickGrid Class="table" Items="context.Countries" Pagination="pagination">
    <PropertyColumn Property="x => x.Name" Sortable="true" />
    <PropertyColumn Property="x => x.Code" Title="Release Date" />
    <PropertyColumn Property="x => x.Details" />
    <PropertyColumn Property="x => x.IsoCode" />
    <PropertyColumn Property="x => x.NativeName" />
    <PropertyColumn Property="x => x.NumericCode" />
    <PropertyColumn Property="x => x.OfficialName" />
    <PropertyColumn Property="x => x.ValidFrom" />
        <PropertyColumn Property="x => x.ValidTo" />

    

    <TemplateColumn Context="x">
        <a href="@($"countries/edit?id={x.Id}")">Edit</a> |
            <a href="@($"countries/details?id={x.Id}")">Details</a> |
            <a href="@($"countries/delete?id={x.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>
</div>
<Paginator State="pagination" />

@code {
    private ApplicationDbContext context = default!;

    protected override void OnInitialized()=> context = DbFactory.CreateDbContext();
    

    public async ValueTask DisposeAsync() => await context.DisposeAsync();

    private string titleFilter = string.Empty;

    private IQueryable<Movie> FilteredMovies => 
        context.Movie.Where(m => m.Name!.Contains(titleFilter));

    private PaginationState pagination = new PaginationState { ItemsPerPage = 5 };
}
